# Qualquer API compatível com OpenAI. Escolha UMA das opções.

# Opção A: OpenRouter (https://openrouter.ai/keys)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=openai/gpt-4o-mini
MIN_SCORE=0.7

# Opção B: Ollama local (ollama pull nomic-embed-text && ollama pull llama3.2)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768
# CHAT_MODEL=llama3.2
# MIN_SCORE=0.82

# MIN_SCORE: score mínimo (0 a 1) para um trecho ir para o modelo. Depende do modelo de embedding:
# calibre com `uv run rag-docs search "<pergunta>"` usando perguntas que a documentação responde
# e perguntas que ela não responde. Veja a seção "Calibrando o MIN_SCORE" do README.

# Neo4j do docker-compose.yml
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=noclaf-school
